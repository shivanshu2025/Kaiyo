# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
# `.next` while `backend/scripts/test-backend.js` parks the production build so
# its `next dev` media suite cannot overwrite it. Restored automatically; this
# entry only stops a failed restore from being committed.
/.next.production-build/
/out/


# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - secrets must never be committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# vercel
.vercel

# development media uploads (local storage driver only; production uses blob/s3)
.uploads/

# NOTE: data/cms.json is the legacy pre-MongoDB content snapshot. It is kept in
# git as the source for scripts/migrate-cms-json.js and is NOT read at runtime.
# data/admin-security.json (the old file-based PIN/session store) is obsolete and
# intentionally still ignored - it must never be committed.

# netlify
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

# --- obsolete / must NOT be committed ---
# NOTE: `backend/` is NOT ignored. Since the Express.js server was removed, that
# folder now holds the live server-side code (models, server-only lib modules and
# the operational scripts) and must be committed. See docs/BACKEND.md.
Kaiyo-main/

# admin / auth legacy (obsolete)
# NOTE: anchored with a leading slash on purpose. Unanchored "admin/" would
# also match the real app/admin/ and components/admin/ dashboard sources.
/admin/
/adminpanel/
/Admin Panel/

# reusable folder names that were backend-related / obsolete
# (top-level only - do not ignore app/components)
/api/
/ui/
/src/api/
/src/auth/
/src/user/
# NOTE: /lib/ is NOT ignored - it holds the browser-side half of the CMS data layer
# (cms-types.ts, use-cms.ts, contact-info.ts, admin-client.ts). The server-only
# half (cms-store.ts, admin-auth.ts, db.ts, guards.ts, ...) now lives in backend/lib/.

# obsolete entry script
/start.js
/server.js

# GitHub Actions / CI workflows (obsolete)
/.github/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Catch-all for any other env file that may appear later.
# `!.env.example` is repeated HERE as well as above because gitignore resolves
# conflicts with LAST MATCH WINS: the previous bare `.env*` at the end of this file
# silently overrode the negation and would have caused a re-added .env.example to
# be ignored. Keep this negation as the final line.
.env*
!.env.example

# Development upload directory (local media storage driver).
.uploads/



/data/admin-security.json