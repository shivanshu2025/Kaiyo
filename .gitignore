/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - secrets must never be committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# vercel
.vercel

# netlify
.netlify/

