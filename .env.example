# =============================================================================
# Kaiyo Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# In production (Vercel/Netlify), set these in the Dashboard > Environment.
# =============================================================================

# Site URL (used for SEO metadata and sitemap generation)
# Optional — if not set, the app will use VERCEL_URL (on Vercel) or http://localhost:3000 (local dev)
# Example for production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin dashboard (/admin)
# -----------------------------------------------------------------------------
# Credentials for POST /api/admin/login. Change these before deploying —
# the built-in fallbacks (admin / admin12345) are only for local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token (HMAC-SHA256).
# Falls back to a hardcoded value if unset, which is unsafe in production.
ADMIN_AUTH_SECRET=change-me-to-a-long-random-string