# =============================================================================
# Kaiyo Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# In production (Vercel/Netlify), set these in the Dashboard > Environment.
# =============================================================================

# Site URL (used for SEO metadata and sitemap generation)
# Optional — if not set, the app will use VERCEL_URL (on Vercel) or http://localhost:3000 (local dev)
# Example for production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
